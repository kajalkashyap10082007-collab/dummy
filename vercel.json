{
  "rewrites": [
    {
      "source": "/about-clothify-sustainable-fashion",
      "destination": "/about-clothify-sustainable-fashion/index.html"
    },
    {
      "source": "/premium-clothing-collection",
      "destination": "/premium-clothing-collection/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/sustainable-fashion-blog",
      "destination": "/sustainable-fashion-blog/index.html"
    },
    {
      "source": "/contact-clothify",
      "destination": "/contact-clothify/index.html"
    },
    {
      "source": "/cart",
      "destination": "/cart/index.html"
    },
    {
      "source": "/wishlist",
      "destination": "/wishlist/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/order-confirmation",
      "destination": "/order-confirmation/index.html"
    },
    {
      "source": "/blog/fall-fashion-trends-2026",
      "destination": "/blog/fall-fashion-trends-2026/index.html"
    },
    {
      "source": "/blog/sustainable-fashion-why-it-matters",
      "destination": "/blog/sustainable-fashion-why-it-matters/index.html"
    },
    {
      "source": "/blog/style-a-classic-white-tshirt",
      "destination": "/blog/style-a-classic-white-tshirt/index.html"
    },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}